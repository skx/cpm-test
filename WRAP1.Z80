;; Test that emulators don't segfault when asked to operate
;; on an FCB which wraps around from the highest address in
;; RAM

        org     100h

include header.inc

start:
        ;; Open
        ld      de, 0xfffb
        ld      c, BDOS_FILE_OPEN
        call    BDOS

        ld      de, passed_msg
        ld      c, BDOS_C_WRITESTR
        call    BDOS

        ;; exit
        ret


passed_msg:
        db "PASSED."
        db 0x0a, 0x0d, "$"

;; Test that marking a drive read-only (BDOS_DRV_SETRO) actually
;; prevents writing to, creating, deleting, and renaming files there.
;;
;; Two empty files are created on drive B before it is marked
;; read-only, so that writing/deleting/renaming can be exercised
;; against files which are already known to exist.

        org     100h

include header.inc

start:
        ;; Remember the current drive, so it can be restored.
        ld      c, BDOS_DRV_GET
        call    BDOS
        ld      (original_drive), a

        ;; Start from a known state, and select drive B.
        ld      c, BDOS_DRV_ALLRESET
        call    BDOS

        ld      e, 1
        ld      c, BDOS_DRV_SET
        call    BDOS

        ;; Remove any leftovers from a previous, aborted, run.
        ld      de, file1
        ld      c, BDOS_FILE_DELETE
        call    BDOS

        ld      de, file2
        ld      c, BDOS_FILE_DELETE
        call    BDOS

        ld      de, file3
        ld      c, BDOS_FILE_DELETE
        call    BDOS

        ld      de, renamed_file
        ld      c, BDOS_FILE_DELETE
        call    BDOS

        ;; Create the two files we'll use to test against, while
        ;; the drive is still writeable.
        ld      de, file1
        ld      c, BDOS_FILE_CREATE
        call    BDOS
        cp      0ffh
        jp      z, failed

        ld      de, file1
        ld      c, BDOS_FILE_CLOSE
        call    BDOS

        ld      de, file2
        ld      c, BDOS_FILE_CREATE
        call    BDOS
        cp      0ffh
        jp      z, failed

        ld      de, file2
        ld      c, BDOS_FILE_CLOSE
        call    BDOS

        ;; Both files should exist now.
        ld      de, file1
        call    file_exists
        jp      nz, failed

        ld      de, file2
        call    file_exists
        jp      nz, failed

        ;; Mark drive B (the currently selected drive) read-only.
        ld      c, BDOS_DRV_SETRO
        call    BDOS

        ;; Creating a new file should now fail ...
        ld      de, file3
        ld      c, BDOS_FILE_CREATE
        call    BDOS
        cp      0ffh
        jp      nz, failed

        ;; ... and it shouldn't actually appear.
        ld      de, file3
        call    file_exists
        jp      z, failed

        ;; Opening an existing file for reading should still work ...
        ld      de, file1
        ld      c, BDOS_FILE_OPEN
        call    BDOS
        cp      0ffh
        jp      z, failed

        ;; ... but writing to it should fail.
        ld      de, file1
        ld      c, BDOS_FILE_WRITE
        call    BDOS
        cp      0ffh
        jp      nz, failed

        ld      de, file1
        ld      c, BDOS_FILE_CLOSE
        call    BDOS

        ;; Deleting a file should fail, and the file should remain.
        ld      de, file2
        ld      c, BDOS_FILE_DELETE
        call    BDOS
        cp      0ffh
        jp      nz, failed

        ld      de, file2
        call    file_exists
        jp      nz, failed

        ;; Renaming a file should fail, and the old name should remain.
        ld      de, rename_fcb
        ld      c, BDOS_FILE_RENAME
        call    BDOS
        cp      0ffh
        jp      nz, failed

        ld      de, file1
        call    file_exists
        jp      nz, failed

        ld      de, renamed_file
        call    file_exists
        jp      z, failed

        ;; All checks passed.
        ld      de, passed_msg
        ld      c, BDOS_C_WRITESTR
        call    BDOS
        jp      cleanup

failed:
        ld      de, failed_msg
        ld      c, BDOS_C_WRITESTR
        call    BDOS

cleanup:
        ;; Clear the read-only flag, so we're able to remove our
        ;; temporary files.
        ld      c, BDOS_DRV_ALLRESET
        call    BDOS

        ld      e, 1
        ld      c, BDOS_DRV_SET
        call    BDOS

        ld      de, file1
        ld      c, BDOS_FILE_DELETE
        call    BDOS

        ld      de, file2
        ld      c, BDOS_FILE_DELETE
        call    BDOS

        ld      de, file3
        ld      c, BDOS_FILE_DELETE
        call    BDOS

        ld      de, renamed_file
        ld      c, BDOS_FILE_DELETE
        call    BDOS

        ;; restore the original drive
        ld      a, (original_drive)
        ld      e, a
        ld      c, BDOS_DRV_SET
        call    BDOS
        ret


passed_msg:
        db      "PASSED."
        db      0x0a, 0x0d, "$"

failed_msg:
        db      "FAILED."
        db      0x0a, 0x0d, "$"

original_drive:
        db      0

; CP/M FCBs
; Byte 0: drive (0 = current)
; Bytes 1-8: filename
; Bytes 9-11: extension
; Remaining bytes are initialized to zero.

file1:
        db      0
        db      "RO2FILE1"
        db      "DAT"
        ds      24,0

file2:
        db      0
        db      "RO2FILE2"
        db      "DAT"
        ds      24,0

file3:
        db      0
        db      "RO2FILE3"
        db      "DAT"
        ds      24,0

renamed_file:
        db      0
        db      "RO2FILE9"
        db      "DAT"
        ds      24,0

;; BDOS_FILE_RENAME expects a 32-byte structure: the first 16 bytes
;; are the (drive + name + type) of the file to rename, the second
;; 16 bytes are the (drive + name + type) it should be renamed to.
rename_fcb:
        db      0
        db      "RO2FILE1"
        db      "DAT"
        ds      4,0
        db      0
        db      "RO2FILE9"
        db      "DAT"
        ds      4,0

include common.inc
